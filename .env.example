# .env example file, what to include, insert & copy

# The two private keys are the contents of the .p8 files on a single line.
# Produce them with:
#   grep -v "PRIVATE KEY" path/to/dbt_key.p8 | tr -d '\n\r'   -> SNOWFLAKE_PRIVATE_KEY
#   grep -v "PRIVATE KEY" path/to/dlt_key.p8 | tr -d '\n\r'   -> DESTINATION__SNOWFLAKE__CREDENTIALS__PRIVATE_KEY

# Swedavia FlightInfo API.
SWEDAVIA_API_KEY=

# Local, where Dagster keeps its run history.
# Container gets its own path from docker-compose.
DAGSTER_HOME=

# dbt connects to Snowflake as its own user, with the dbt key.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_PRIVATE_KEY=

# dlt connects as a separate user, with the dlt key.
# Values that mirror .dlt/secrets.toml,
# which is what dlt reads when running it locally.
DESTINATION__SNOWFLAKE__CREDENTIALS__HOST=
DESTINATION__SNOWFLAKE__CREDENTIALS__USERNAME=
DESTINATION__SNOWFLAKE__CREDENTIALS__ROLE=
DESTINATION__SNOWFLAKE__CREDENTIALS__DATABASE=
DESTINATION__SNOWFLAKE__CREDENTIALS__WAREHOUSE=
DESTINATION__SNOWFLAKE__CREDENTIALS__PRIVATE_KEY=